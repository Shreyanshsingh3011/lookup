PORT=3001

# Optional: load orbital elements from a local Celestrak-format file instead of
# fetching them. Takes precedence over the network, and responses report
# source="file" so the UI states where the numbers came from. Useful for
# air-gapped deployments, reproducible predictions, and running against
# known-current elements where celestrak.org is unreachable.
# TLE_FILE=./elements.txt

# Force the bundled dev fixture fallback on (1) or off (0). Defaults to on
# outside production.
# ALLOW_TLE_FIXTURE=0
